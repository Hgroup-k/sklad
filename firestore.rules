rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function acc() { return get(/databases/$(database)/documents/access/main).data; }
    function signedIn() { return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function me() { return request.auth != null ? request.auth.uid : ''; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == acc().owner; }
    function isFull() { return signedIn() && (isOwner() || email() in acc().editors); }
    function isViewer() { return signedIn() && email() in acc().viewers; }
    function perms() { return acc().get('perms', {}); }
    function custom() { return signedIn() && email() in perms(); }
    function lv(s) { return custom() ? perms()[email()].get(s, 'none') : 'none'; }
    function canEdit(s) { return isFull() || (custom() && (lv(s) == 'edit' || lv(s) == true)); }
    function canView(s) { return canEdit(s) || isViewer() || (custom() && lv(s) == 'view'); }
    function anyAccess() { return isFull() || isViewer() || custom(); }
    function clean() { return isOwner() || (custom() && lv('chatmod') == 'edit'); }
    function opsView() { return canView('input') || canView('journal') || canView('stock') || canView('period')
      || canView('sizes') || canView('months') || canView('orders') || canView('returns') || canView('plan')
      || canView('porders') || canView('cast11') || canView('dry11') || canView('demold11') || canView('cut11')
      || canView('pack11') || canView('grout') || canView('cast9') || canView('dry9') || canView('demold9')
      || canView('sand9') || canView('pack9') || canView('grease11') || canView('porders9')
      || canView('wh11') || canView('wh9') || canView('sorders'); }
    function matView() { return canView('mstock') || canView('mops') || canView('buy'); }
    function opsEdit() { return canEdit('input') || canEdit('journal') || canEdit('stock'); }
    function prodEdit() { return canEdit('grease11') || canEdit('cast11') || canEdit('demold11') || canEdit('cut11') || canEdit('pack11')
      || canEdit('grout') || canEdit('cast9') || canEdit('demold9') || canEdit('sand9') || canEdit('pack9'); }

    match /access/main {
      allow read: if signedIn() && anyAccess();
      allow update, delete: if isOwner();
    }
    match /people/{uid} {
      allow read: if anyAccess() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /unames/{n} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    function fx(i) { return i == 'all' || i == 'orders'; }
    function fk(i) { return i == 'all' ? 'chatall' : 'chatord'; }
    function clv(s) { return isFull() ? 'edit' : isViewer() ? 'view' : custom() ? perms()[email()].get(s, 'edit') : 'none'; }
    function chatBoss(id) { return !fx(id) && (get(/databases/$(database)/documents/chats/$(id)).data.by == me()
      || (get(/databases/$(database)/documents/chats/$(id)).data.type == 'dm' && me() in get(/databases/$(database)/documents/chats/$(id)).data.members)); }
    match /chats/{id} {
      allow get: if anyAccess() && (fx(id) ? clv(fk(id)) != 'none' : me() in resource.data.members);
      allow list: if anyAccess() && me() in resource.data.members;
      allow create: if anyAccess() && (fx(id) ? clv(fk(id)) == 'edit' : (me() in request.resource.data.members && request.resource.data.by == me()));
      allow update: if anyAccess() && (fx(id) ? clv(fk(id)) == 'edit' : me() in resource.data.members);
      allow delete: if anyAccess() && !fx(id) && (resource.data.by == me() || (resource.data.type == 'dm' && me() in resource.data.members));
      match /msgs/{m} {
        allow read: if anyAccess() && (fx(id) ? clv(fk(id)) != 'none' : me() in get(/databases/$(database)/documents/chats/$(id)).data.members);
        allow create: if anyAccess() && request.resource.data.uid == me()
          && (fx(id) ? clv(fk(id)) == 'edit' : me() in get(/databases/$(database)/documents/chats/$(id)).data.members);
        allow update: if anyAccess() && (
          (resource.data.uid == me() && request.resource.data.uid == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t', 'ed'])
            && (request.resource.data.diff(resource.data).affectedKeys().hasAll(['ed']) || clean()))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
            && request.resource.data.rx.diff(resource.data.get('rx', {})).affectedKeys().hasOnly([me()])
            && (fx(id) ? clv(fk(id)) != 'none' : me() in get(/databases/$(database)/documents/chats/$(id)).data.members))
          || ((resource.data.uid == me() || clean()) && request.resource.data.kind == 'del'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.keys().hasOnly(['uid', 'at', 'kind', 'del', 'by'])));
        allow delete: if anyAccess() && (clean() || chatBoss(id));
      }
      match /files/{f} {
        allow read: if anyAccess() && (fx(id) ? clv(fk(id)) != 'none' : me() in get(/databases/$(database)/documents/chats/$(id)).data.members);
        allow create: if anyAccess() && request.resource.data.uid == me()
          && (fx(id) ? clv(fk(id)) == 'edit' : me() in get(/databases/$(database)/documents/chats/$(id)).data.members);
        allow delete: if anyAccess() && (resource.data.uid == me() || clean() || chatBoss(id));
      }
    }
    match /tasks/{id} {
      allow read: if signedIn() && (canView('tasks') || resource.data.to == me() || resource.data.by == me()
        || me() in resource.data.get('watch', []));
      allow create: if (canEdit('tasks') || (canEdit('mops') && request.resource.data.get('auto', '') == 'opyt')
          || ((canEdit('mops') || canEdit('buy')) && request.resource.data.get('auto', '') == 'buy')
          || (canEdit('orders') && request.resource.data.get('auto', '') == 'dlv'))
        && request.resource.data.by == me();
      allow update: if canEdit('tasks') || (signedIn() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'cm', 'upd']));
      allow delete: if canEdit('tasks');
    }
    match /reads/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /push/{uid} {
      allow read: if anyAccess();
      allow write: if anyAccess() && request.auth.uid == uid;
    }
    match /orders/{id} {
      allow read: if canView('orders') || canView('porders') || canView('porders9') || canView('grout') || canView('sorders');
      allow write: if canEdit('orders');
      allow update: if (canEdit('porders') || canEdit('porders9'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'work', 'ready', 'prod']);
      allow update: if canEdit('sorders')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sk']);
    }
    match /returns/{id} {
      allow read: if canView('returns');
      allow write: if canEdit('returns');
    }
    match /months/{m}/ops/{id} {
      allow read: if opsView();
      allow create: if opsEdit()
        || (prodEdit() && request.resource.data.get('step', '') != '')
        || (canEdit('orders') && request.resource.data.get('order', '') != '')
        || (canEdit('returns') && request.resource.data.get('ret', '') != '');
      allow update: if opsEdit()
        || (canEdit('orders') && request.resource.data.get('order', '') != '')
        || (canEdit('returns') && request.resource.data.get('ret', '') != '');
      allow delete: if opsEdit()
        || (canEdit('orders') && resource.data.get('order', '') != '')
        || (canEdit('returns') && resource.data.get('ret', '') != '');
    }
    match /qc/{id} {
      allow read: if canView('qc');
      allow write: if canEdit('qc');
    }
    match /clients/{id} {
      allow read: if canView('clients') || canView('orders');
      allow write: if canEdit('clients') || canEdit('orders');
    }
    match /config/driver {
      allow read: if signedIn();
      allow write: if canEdit('tasks');
    }
    match /config/mats {
      allow read: if matView();
      allow write: if canEdit('mstock');
    }
    match /matops/{id} {
      allow read: if matView();
      allow create: if canEdit('mops') && request.resource.data.by == me();
      allow update, delete: if canEdit('mops');
    }
    match /buy/{id} {
      allow read: if matView();
      allow write: if canEdit('buy') || canEdit('mops');
    }
    match /config/plan {
      allow read: if canView('plan');
      allow write: if canEdit('plan');
    }
    match /config/catalog {
      allow read: if anyAccess();
      allow write: if canEdit('catalog');
    }
    match /config/lists {
      allow read: if anyAccess();
      allow write: if canEdit('catalog');
    }
    match /config/taskSees {
      allow read: if signedIn();
      allow write: if canEdit('tasks');
    }
    match /config/backups {
      allow read, write: if isFull();
    }
    match /backups/{id} {
      allow read, write: if isFull();
    }
  }
}
