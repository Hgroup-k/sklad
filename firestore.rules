rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function acc() { return get(/databases/$(database)/documents/access/main).data; }
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == acc().owner; }
    function isFull() { return signedIn() && (isOwner() || email() in acc().editors); }
    function perms() { return acc().get('perms', {}); }
    function sec(s) { return isFull() || (signedIn() && email() in perms() && perms()[email()].get(s, false) == true); }
    function anyWrite() { return isFull() || (signedIn() && email() in perms()); }
    function canRead() { return anyWrite() || (signedIn() && email() in acc().viewers); }

    match /access/main {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == email();
      allow update, delete: if isOwner();
    }
    match /people/{uid} {
      allow read: if canRead();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /orders/{id} {
      allow read: if canRead();
      allow write: if sec('orders');
    }
    match /returns/{id} {
      allow read: if canRead();
      allow write: if sec('returns');
    }
    match /months/{m}/ops/{id} {
      allow read: if canRead();
      allow create, update: if sec('stock')
        || (sec('orders') && request.resource.data.get('order', '') != '')
        || (sec('returns') && request.resource.data.get('ret', '') != '');
      allow delete: if sec('stock')
        || (sec('orders') && resource.data.get('order', '') != '')
        || (sec('returns') && resource.data.get('ret', '') != '');
    }
    match /config/plan {
      allow read: if canRead();
      allow write: if sec('plan');
    }
    match /config/{doc} {
      allow read: if canRead();
      allow write: if (doc == 'catalog' || doc == 'lists') && sec('catalog');
    }
    match /config/backups {
      allow read: if canRead();
      allow write: if anyWrite();
    }
    match /backups/{id} {
      allow read: if canRead();
      allow write: if anyWrite();
    }
  }
}
